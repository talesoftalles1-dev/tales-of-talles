# Copia para .env e preenche. Gera a chave com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
N8N_ENCRYPTION_KEY=COLA_UMA_CHAVE_ALEATORIA_AQUI

GENERIC_TIMEZONE=Europe/Lisbon
TZ=Europe/Lisbon

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# N8N_SECURE_COOKIE=false

# URL público onde o n8n regista os webhooks (túnel/reverse-proxy):
# WEBHOOK_URL=https://<subdominio>.trycloudflare.com/
# N8N_PROXY_HOPS=1

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_RUNNERS_ENABLED=true
