      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst b = ($input.first() && $input.first().json && $input.first().json.body) || {};\nconst content = [{ type: 'text', text: String(b.prompt || 'Descreve a imagem em JSON.') }];\n(b.images || []).forEach(im => { if (im && im.media_type && im.data) content.push({ type: 'image', source: { type: 'base64', media_type: im.media_type, data: im.data } }); });\nreturn [{ json: { payload: { model: 'claude-sonnet-4-20250514', max_tokens: Number(b.max_tokens) || 500, messages: [{ role: 'user', content }] } } }];\n"
      }
    },
    {
      "id": "5b38573a-d875-4105-b4f0-201ace310017",
