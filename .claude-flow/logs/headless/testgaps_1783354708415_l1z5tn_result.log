      },
      {
        "title": "2. `lib/vault.mjs` — hand-rolled parser has zero validation",
        "content": "\n`loadVault`/`extractTasks`/`isRecurringStale` are exported; the frontmatter/YAML parser (`parseFrontmatter`, `parseSimpleYaml`, `coerce`, `unquote`) is entirely internal and only reachable through `loadVault` on real files, or `extractTasks` on a `body` string.\n\n**Uncovered edge cases:**\n- CRLF normalization (there's a comment about a real bug this fixed — no regression test exists).\n- Missing frontmatter vs unterminated frontmatter (`---` opens but never closes).\n- `coerce`: `\"007\"` → `Number(\"007\")` silently drops the leading zero — likely a latent bug for any zero-padded numeric string property.\n- Task regex: nested/toggled code fences suppress task extraction; `[X]` uppercase done-marker; multiple date emoji in one line.\n- `isRecurringStale`: no 🔁 → false; 🔁 with no due → true; due in past vs future.\n- `SKIP_FOLDERS`: must not falsely match `\"90 ArquivoExtra\"` as a prefix of `\"90 Arquivo\"`.\n\n```js\n// lib/vault.test.mjs\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { loadVault, extractTasks, isRecurringStale } from \"./vault.mjs\";\n\nfunction makeTmpVault(files) {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"jarvis-vault-\"));\n  for (const [rel, content] of Object.entries(files)) {\n    const full = path.join(root, rel);\n    fs.mkdirSync(path.dirname(full), { recursive: true });\n    fs.writeFileSync(full, content);\n  }\n  return root;\n}\n\ntest(\"loadVault: parses CRLF frontmatter correctly\", () => {\n  const root = makeTmpVault({\n    \"note.md\": \"---\\r\\ntipo: projeto\\r\\nstatus: ativo\\r\\n---\\r\\nbody\\r\\n\",\n  });\n  const { notes } = loadVault(root);\n  assert.equal(notes[0].tipo, \"projeto\");\n  assert.equal(notes[0].status, \"ativo\");\n});\n\ntest(\"loadVault: skips '90 Arquivo' but not lookalike folder names\", () => {\n  const root = makeTmpVault({\n    \"90 Arquivo/old.md\": \"---\\ntipo: projeto\\n---\\n\",\n    \"90 ArquivoExtra/keep.md\": \"---\\ntipo: projeto\\n---\\n\",\n  });\n  const { notes } = loadVault(root);\n  assert.deepEqual(notes.map((n) => n.basename), [\"keep\"]);\n});\n\ntest(\"extractTasks: ignores tasks inside code fences\", () => {\n  const body = \"```\\n- [ ] fake task\\n```\\n- [ ] real task\\n\";\n  const tasks = extractTasks(body, { path: \"x.md\", basename: \"x\" });\n  assert.equal(tasks.length, 1);\n  assert.equal(tasks[0].text, \"real task\");\n});\n\ntest(\"extractTasks: extracts due/scheduled/completed dates independently\", () => {\n  const body = \"- [ ] ship it 📅 2026-07-10 ⏳ 2026-07-08\\n\";\n  const [t] = extractTasks(body, { path: \"x.md\", basename: \"x\" });\n  assert.equal(t.due, \"2026-07-10\");\n  assert.equal(t.scheduled, \"2026-07-08\");\n  assert.equal(t.text, \"ship it\");\n});\n\ntest(\"isRecurringStale\", () => {\n  assert.equal(isRecurringStale({ rawLine: \"- [ ] x\", due: null }, \"2026-07-06\"), false);\n  assert.equal(isRecurringStale({ rawLine: \"🔁 x\", due: null }, \"2026-07-06\"), true);\n  assert.equal(isRecurringStale({ rawLine: \"🔁 x\", due: \"2026-07-01\" }, \"2026-07-06\"), true);\n  assert.equal(isRecurringStale({ rawLine: \"🔁 x\", due: \"2026-07-10\" }, \"2026-07-06\"), false);\n});\n```\n\n*Recommendation:* export `parseSimpleYaml`/`coerce` (even just for tests) — right now the only way to catch a `coerce` regression is via a full `loadVault` round-trip, which makes failures hard to localize.\n\n---\n\n",
        "level": 2
      },
      {
        "title": "3. `lib/brief.mjs` — business logic almost entirely in unexported helpers",
        "content": "\nOnly `buildMorningBrief` is exported; `selectTop3`, `collectRisks`, `collectCommercial`, `selectProjectsAttention`, `collectToday`, `dedupeByText` are all reached only through it. This means every scenario needs a full `{notes, tasks}` fixture.\n\n**Uncovered edge cases / possible bug worth a test:**\n- `collectCommercial`: a client can generate *two different-text* risk items (`RevenueRiskDetected` from `proximo_contato` overdue **and** from `valor >= 10000` pipeline risk). `dedupeByText` dedupes by exact text, so both survive — verify this is intended, not a duplicate-noise bug.\n- `ProjectAtRisk`: boundary at `progresso === 70` (should NOT trigger, only `< 70`) and `daysLeft === 3` (should trigger) vs `daysLeft === 4` (should not).\n- `selectTop3`: recurring-stale tasks excluded even if due today; today-due tasks always rank before overdue ones regardless of priority marker.\n- `collectToday`: case-insensitive dedupe of same-text tasks; meeting basename date-prefix stripping.\n- Empty-state text for every section in `formatBriefText`.\n\n```js\n// lib/brief.test.mjs\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { buildMorningBrief } from \"./brief.mjs\";\n\nconst today = \"2026-07-06\";\n\ntest(\"buildMorningBrief: empty vault produces all-empty placeholders\", () => {\n  const brief = buildMorningBrief({ notes: [], tasks: [] }, { today });\n  assert.match(brief.text, /nenhuma ação crítica/);\n  assert.match(brief.text, /nada travado/);\n  assert.match(brief.text, /agenda livre/);\n});\n\ntest(\"collectRisks (via buildMorningBrief): ProjectAtRisk boundary at progresso=70\", () => {\n  const atRisk = { tipo: \"projeto\", status: \"ativo\", basename: \"P1\", prazo: \"2026-07-08\", progresso: 69 };\n  const notRisk = { tipo: \"projeto\", status: \"ativo\", basename: \"P2\", prazo: \"2026-07-08\", progresso: 70 };\n  const brief = buildMorningBrief({ notes: [atRisk, notRisk], tasks: [] }, { today });\n  assert.ok(brief.risks.some((r) => r.text.includes(\"P1\")));\n  assert.ok(!brief.risks.some((r) => r.text.includes(\"P2\")));\n});\n\ntest(\"selectTop3: recurring-stale task excluded even though due today\", () => {\n  const tasks = [\n    { done: false, due: today, rawLine: \"🔁 x\", text: \"stale recurring\", sourceBasename: \"n\" },\n    { done: false, due: today, rawLine: \"x\", text: \"real task\", sourceBasename: \"n\" },\n  ];\n  const brief = buildMorningBrief({ notes: [], tasks }, { today });\n  assert.equal(brief.top3.length, 1);\n  assert.equal(brief.top3[0].text, \"real task\");\n});\n\ntest(\"collectToday: dedupes same task text case-insensitively\", () => {\n  const tasks = [\n    { done: false, due: today, text: \"Call client\", rawLine: \"\" },\n    { done: false, scheduled: today, text: \"call client\", rawLine: \"\" },\n  ];\n  const brief = buildMorningBrief({ notes: [], tasks }, { today });\n  assert.equal(brief.today.filter((i) => i.kind === \"TaskCreated\").length, 1);\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "4. `lib/slack.mjs` — delivery routing, dry-run, and error paths untested",
        "content": "\n**Missing error-handling tests specifically:**\n- `publishToSlack` throws when *no* delivery config is present at all — never exercised.\n- Non-2xx response on n8n webhook and Slack incoming webhook — error message includes status + body.\n- Bot API `data.ok === false` → throws with `data.error`.\n- `loadPostState` swallows corrupt JSON → returns `null` (silent-fail path, no test).\n- `postN8nWebhook`'s JSON-parse-fallback-to-raw-text branch (`res.json()` throws → falls back, and even `res.text()` inside the catch can itself throw, swallowed to `\"\"`).\n\n```js\n// lib/slack.test.mjs\nimport { test, mock, beforeEach, afterEach } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport {\n  publishToSlack, saveBriefLocally, loadPostState, savePostState, alreadyPostedToday,\n} from \"./slack.mjs\";\n\nlet originalFetch;\nbeforeEach(() => { originalFetch = global.fetch; });\nafterEach(() => { global.fetch = originalFetch; });\n\ntest(\"publishToSlack: throws when no delivery method configured\", async () => {\n  await assert.rejects(() => publishToSlack(\"text\", {}), /Entrega não configurada/);\n});\n\ntest(\"publishToSlack: n8n path throws with status+body on non-ok response\", async () => {\n  global.fetch = mock.fn(async () => ({ ok: false, status: 500, text: async () => \"boom\" }));\n  await assert.rejects(\n    () => publishToSlack(\"text\", { n8nWebhookUrl: \"http://x\" }, { date: \"2026-07-06\" }),\n    /n8n webhook falhou \\(500\\): boom/\n  );\n});\n\ntest(\"publishToSlack: bot path throws on data.ok=false\", async () => {\n  global.fetch = mock.fn(async () => ({ ok: true, json: async () => ({ ok: false, error: \"invalid_auth\" }) }));\n  await assert.rejects(\n    () => publishToSlack(\"text\", { slackBotToken: \"t\", slackChannel: \"#c\" }),\n    /Slack API falhou: invalid_auth/\n  );\n});\n\ntest(\"publishToSlack: dryRun short-circuits before any fetch call\", async () => {\n  global.fetch = mock.fn();\n  const result = await publishToSlack(\"text\", { n8nWebhookUrl: \"http://x\" }, { dryRun: true });\n  assert.equal(result.dryRun, true);\n  assert.equal(global.fetch.mock.calls.length, 0);\n});\n\ntest(\"loadPostState: corrupt JSON returns null instead of throwing\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"jarvis-state-\"));\n  const file = path.join(dir, \"state.json\");\n  fs.writeFileSync(file, \"{not json\");\n  assert.equal(loadPostState(file), null);\n});\n\ntest(\"alreadyPostedToday: force=true always returns false\", () => {\n  assert.equal(alreadyPostedToday({ date: \"2026-07-06\", posted: true }, \"2026-07-06\", true), false);\n});\n\ntest(\"alreadyPostedToday: missing state returns false\", () => {\n  assert.equal(alreadyPostedToday(undefined, \"2026-07-06\", false), false);\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "5. `generate.mjs` and `executive-assistant/dashboard.mjs` — integration gaps",
        "content": "\nBoth are CLI entry points with real filesystem + (for `generate.mjs`) network side effects, and neither has an integration test covering the exit-code contract that's documented in comments (`0=ok`, `1=vault inacessível`, `2=gerado mas não entregue`).\n\n**Missing integration scenarios:**\n- `generate.mjs`: already-posted-today short-circuit (unless `--force`); vault load failure → `exitCode=1`, run log written with `status: \"vault_error\"`; Slack failure → `exitCode=2` but brief still saved locally and `saveBriefLocally` path logged; `--dry-run` never calls `publishToSlack`'s network path; `--no-slack` skips publish entirely.\n- `dashboard.mjs`: `countInboxPending` only counts lines under the `## Capturas pendentes` heading and stops at the next heading; `preserveCriado` keeps existing `criado:` date across regenerations (this is a stated invariant — no test protects it); `--dry-run` must not write the output file.\n\n```js\n// generate.integration.test.mjs\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { execFileSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\n\n// Build a minimal fixture vault + point JARVIS_VAULT_ROOT / config.json at it,\n// then invoke `node generate.mjs --dry-run --print` and assert on stdout + exit code.\ntest(\"generate.mjs --dry-run: exits 0, writes brief locally, does not call Slack\", () => {\n  const vaultRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"jarvis-fixture-\"));\n  // ...write a fixture note + config.json pointing outputDir/stateFile into vaultRoot...\n  const out = execFileSync(\"node\", [\"generate.mjs\", \"--dry-run\", \"--print\"], {\n    cwd: path.resolve(\"70 Sistema/Automacao/morning-brief\"),\n    env: { ...process.env },\n  }).toString();\n  assert.match(out, /JARVIS Morning Brief/);\n});\n\ntest(\"generate.mjs: vault load failure exits with code 1\", () => {\n  assert.throws(() => {\n    execFileSync(\"node\", [\"generate.mjs\"], {\n      cwd: path.resolve(\"70 Sistema/Automacao/morning-brief\"),\n      env: { ...process.env, JARVIS_VAULT_ROOT: \"/nonexistent/path\" },\n    });\n  }, (err) => err.status === 1);\n});\n```\n\n```js\n// executive-assistant/dashboard.test.mjs\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\n// countInboxPending and preserveCriado aren't exported — export them, or drive via\n// a temp vault + `--dry-run --print` on dashboard.mjs and assert on stdout sections.\n\ntest(\"dashboard --dry-run does not write output/daily_dashboard.md\", () => {\n  // set JARVIS_VAULT_ROOT to a temp vault, run with --dry-run,\n  // assert fs.existsSync(outputPath) === false\n});\n\ntest(\"preserveCriado keeps original 'criado:' date across reruns\", () => {\n  // write output/daily_dashboard.md with criado: 2026-01-01,\n  // rerun without --dry-run, assert the regenerated file still has criado: 2026-01-01\n});\n```\n\n*Note:* both `countInboxPending` and `preserveCriado` in `dashboard.mjs` are currently unexported — exporting them turns two integration tests into two fast unit tests.\n\n---\n\n",
        "level": 2
      },
      {
        "title": "6. `scripts/bootstrap_jarvis_os.js` and `sample/scripts/external_id.js`",
        "content": "\n- `external_id.js` already exports `generateExternalId` and guards its CLI with `require.main === module` — the easiest of the two to test as-is. Untested: determinism (same input → same hash), 12-char length, different inputs → different hashes, path-separator normalization.\n- `bootstrap_jarvis_os.js` executes its file-writing side effects at module load time with no `require.main` guard and no exports — **it cannot be unit tested without either refactoring it to export `ensureDir`/`frontmatter`/a `run()` function, or shelling out to `node bootstrap_jarvis_os.js` in a temp `cwd`.** Flag this as a coverage gap that requires a small refactor first.\n\n```js\n// sample/scripts/external_id.test.js\nconst { test } = require(\"node:test\");\nconst assert = require(\"node:assert/strict\");\nconst { generateExternalId } = require(\"./external_id.js\");\n\ntest(\"generateExternalId: deterministic for same inputs\", () => {\n  const a = generateExternalId(\"/repo\", \"notes/x.md\");\n  const b = generateExternalId(\"/repo\", \"notes/x.md\");\n  assert.equal(a, b);\n  assert.equal(a.length, 12);\n});\n\ntest(\"generateExternalId: different notePath yields different id\", () => {\n  const a = generateExternalId(\"/repo\", \"notes/x.md\");\n  const b = generateExternalId(\"/repo\", \"notes/y.md\");\n  assert.notEqual(a, b);\n});\n```\n\n```js\n// scripts/bootstrap_jarvis_os.test.js — BLOCKED until refactor\n// Currently the script has no exports and runs its fs writes at require-time.\n// Minimal fix to make it testable: wrap the `volumes.forEach(...)` block in a\n// `function run(cwd) {...}` + `module.exports = { run, ensureDir, frontmatter }`,\n// and only auto-run under `if (require.main === module) run(process.cwd())`\n// (same pattern already used in external_id.js).\n```\n\n---\n\n",
