        "code": "// 70 Sistema/Automacao/morning-brief/lib/vault.test.mjs\nimport { test, describe, before, after } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { loadVault, extractTasks, isRecurringStale } from \"./lib/vault.mjs\";\n\ndescribe(\"loadVault\", () => {\n  let vaultDir;\n  before(() => {\n    vaultDir = fs.mkdtempSync(path.join(os.tmpdir(), \"jarvis-vault-\"));\n  });\n  after(() => fs.rmSync(vaultDir, { recursive: true, force: true }));\n\n  test(\"regression: CRLF-terminated notes still parse frontmatter (past prod bug)\", () => {\n    const content = \"---\\r\\ntipo: projeto\\r\\nstatus: ativo\\r\\n---\\r\\n\\r\\n- [ ] foo 📅 2026-07-06\\r\\n\";\n    fs.writeFileSync(path.join(vaultDir, \"crlf-note.md\"), content);\n    const { notes, tasks } = loadVault(vaultDir);\n    const note = notes.find((n) => n.fileName === \"crlf-note.md\");\n    assert.equal(note.tipo, \"projeto\");\n    assert.equal(tasks.length, 1);\n  });\n\n  test(\"skips 70 Sistema/Templates, 90 Arquivo, .obsidian, .claude\", () => {\n    fs.mkdirSync(path.join(vaultDir, \"70 Sistema\", \"Templates\"), { recursive: true });\n    fs.writeFileSync(path.join(vaultDir, \"70 Sistema\", \"Templates\", \"t.md\"), \"---\\ntipo: template\\n---\\n\");\n    const { notes } = loadVault(vaultDir);\n    assert.ok(!notes.some((n) => n.fileName === \"t.md\"));\n  });\n\n  test(\"malformed frontmatter (no closing ---) treats whole file as body\", () => {\n    fs.writeFileSync(path.join(vaultDir, \"broken.md\"), \"---\\ntipo: projeto\\nsem fechamento\\n\");\n    const { notes } = loadVault(vaultDir);\n    const note = notes.find((n) => n.fileName === \"broken.md\");\n    assert.equal(note.tipo, undefined); // documents current (possibly undesired) behavior\n  });\n});\n\ndescribe(\"extractTasks\", () => {\n  test(\"parses due/scheduled/completed dates and strips emoji from text\", () => 